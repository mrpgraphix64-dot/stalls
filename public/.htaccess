<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block direct web access to private data directory, CLI scripts, and helpers
  RewriteRule ^data/ - [F,L]
  RewriteRule ^reworkzone_data/ - [F,L]
  RewriteRule ^manage/.*cli\.php$ - [F,L]
  RewriteRule ^manage/api/(config|auth-helper)\.php$ - [F,L]

  # 2. Existing Admin Portal rewrite (/admin -> /admin.php)
  RewriteRule ^admin/?$ admin.php [L]

  # 3. Route clean API URLs: /manage/api/<endpoint> to /manage/api/<endpoint>.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^manage/api/([^/]+)/?$ manage/api/$1.php [L,QSA]

  # 3b. Serve 3D preview uploads through persistent image streamer if missing in webroot
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^uploads/3d_previews/([^/]+)$ manage/api/preview-image.php?file=$1 [L,QSA]

  # 4. Route all non-API /manage requests to SPA index.html
  RewriteCond %{REQUEST_URI} !^/manage/api/
  RewriteRule ^manage(?:/.*)?$ /index.html [L]

  # 5. SPA Fallback for other frontend routes (DO NOT rewrite static files / images to index.html!)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(jpe?g|png|gif|webp|svg|ico|css|js|map|woff2?|ttf|eot)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/webp .webp
  AddType image/png .png
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|ico|woff|woff2)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Block direct web access to sensitive inquiry data, databases, secrets, and logs
<FilesMatch "^(enquiries.*|.*\.csv|.*\.log|.*\.sqlite|.*\.db|.*\.bak|.*\.env|.*\.sql|.*\.sh)$">
  Require all denied
</FilesMatch>
